{
  "name": "smartreceipt-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "node scripts/copy-pdf-worker.mjs && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "verify": "npm run typecheck && npm run test && npm run build",
    "test:integration": "tsx scripts/integration-check.ts",
    "evaluate:ai": "tsx scripts/evaluate-ai.ts",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "test:fx-live": "tsx scripts/check-fx.ts",
    "test:public": "tsx scripts/check-public.ts",
    "test:guest-live": "tsx scripts/guest-flow.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pdf-lib": "1.17.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
